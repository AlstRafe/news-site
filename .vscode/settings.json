{
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": { "newsreader/templates/*.html": "jinja-html" },
  "prettier.requireConfig": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.fixAll.ruff": "explicit", "source.organizeImports.ruff": "explicit" }
  },
  "[javascript][css][json][jsonc][markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html][jinja-html]": { "editor.formatOnSave": false },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-q"]
}
